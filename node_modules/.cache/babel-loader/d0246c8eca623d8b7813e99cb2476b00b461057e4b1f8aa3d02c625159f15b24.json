{ ...item, quantity: item.quantity + 1 }\n          : item\n      )\n    );\n  };\n\n  const decreaseQuantity = (id) => {\n    setCart(\n      cart.map((item) =>\n        item.id === id && item.quantity > 1\n          ? { ...item, quantity: item.quantity - 1 }\n          : item\n      )\n    );\n  };\n\n  const total = cart.reduce(\n    (sum, item) => sum + item.price * item.quantity,\n    0\n  );\n\n  return (\n    <div className=\"App\">\n      <h1>Shopping Cart</h1>\n\n      {cart.map((item) => (\n        <div className=\"product\" key={item.id}>\n          <h2>{item.name}</h2>\n          <p>Price: ₹{item.price}</p>\n          <p>Quantity: {item.quantity}</p>\n\n          <button onClick={() => decreaseQuantity(item.id)}>\n            -\n          </button>\n\n          <button onClick={() => increaseQuantity(item.id)}>\n            +\n          </button>\n        </div>\n      ))}\n\n      <h2>Total: ₹{total}</h2>\n    </div>\n  );\n}\n\nexport default App;"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,KAAQ,OAAO,CACvC,MAAO,WAAW,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEnB,QAAS,CAAAC,GAAGA,CAAA,CAAG,CACb,KAAM,CAACC,IAAI,CAAEC,OAAO,CAAC,CAAGP,QAAQ,CAAC,CAC/B,CAAEQ,EAAE,CAAE,CAAC,CAAEC,IAAI,CAAE,QAAQ,CAAEC,KAAK,CAAE,KAAK,CAAEC,QAAQ,CAAE,CAAE,CAAC,CACpD,CAAEH,EAAE,CAAE,CAAC,CAAEC,IAAI,CAAE,YAAY,CAAEC,KAAK,CAAE,IAAI,CAAEC,QAAQ,CAAE,CAAE,CAAC,CACvD,CAAEH,EAAE,CAAE,CAAC,CAAEC,IAAI,CAAE,OAAO,CAAEC,KAAK,CAAE,GAAG,CAAEC,QAAQ,CAAE,CAAE,CAAC,CAClD,CAAC,CAEF,KAAM,CAAAC,gBAAgB,CAAIJ,EAAE,EAAK,CAC/BD,OAAO,CACLD,IAAI,CAACO,GAAG,CAAEC,IAAI,EACZA,IAAI,CAACN,EAAE,GAAKA,EAAE,CACV,CAAE,GAAGM,IAAI,CAAEH,QAAQ,CAAEG,IAAI,CAACH,QAAQ,CAAG,CAAE,CAAC,CACxCG,IACN,CACF,CAAC,CACH,CAAC,CAED,KAAM,CAAAC,gBAAgB,CAAIP,EAAE,EAAK,CAC/BD,OAAO,CACLD,IAAI,CAACO,GAAG,CAAEC,IAAI,EACZA,IAAI,CAACN,EAAE,GAAKA,EAAE,EAAIM,IAAI,CAACH,QAAQ,CAAG,CAAC,CAC/B,CAAE,GAAGG,IAAI,CAAEH,QAAQ,CAAEG,IAAI,CAACH,QAAQ,CAAG,CAAE,CAAC,CACxCG,IACN,CACF,CAAC,CACH,CAAC,CAED,KAAM,CAAAE,KAAK,CAAGV,IAAI,CAACW,MAAM,CACvB,CA